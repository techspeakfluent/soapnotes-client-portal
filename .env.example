VITE_API_BASE_URL=

# Mock data served while the client-portal endpoints are being built:
# default | empty (a brand-new client) | error (every request fails)
VITE_MOCK_SCENARIO=default

# Shows "Continue with demo account" on the sign-in screen. Set to false
# once real client login exists.
VITE_ENABLE_DEMO_SIGN_IN=true
